<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.star.pivot.file.mapper.SysFileVersionMapper">

    <select id="selectMaxVersionNo" resultType="java.lang.Integer">
        SELECT MAX(version_no)
        FROM sys_file_version
        WHERE file_id = #{fileId}
    </select>

    <select id="countByObjectName" resultType="long">
        SELECT COUNT(1)
        FROM sys_file_version
        WHERE object_name = #{objectName}
        <if test="excludeVersionId != null">
            AND version_id &lt;&gt; #{excludeVersionId}
        </if>
    </select>

    <delete id="deleteByFileId">
        DELETE FROM sys_file_version WHERE file_id = #{fileId}
    </delete>
</mapper>
