# ============================================
# StarPivot Docker 环境变量配置
# ============================================
# 复制此文件为 .env 并修改相应配置

# MySQL 配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=star-pivot
MYSQL_USER=starpivot
MYSQL_PASSWORD=starpivot123
MYSQL_PORT=3306

# Redis 配置
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# 应用配置
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080
JWT_SECRET=your-secret-key-change-in-production-must-be-at-least-32-bytes-long
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# OSS 配置（可选）
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=star-pivot

# Nginx 配置（可选）
NGINX_PORT=80
NGINX_HTTPS_PORT=443
